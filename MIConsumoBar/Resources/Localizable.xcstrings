{
  "sourceLanguage" : "en",
  "strings" : {
    "¿Cómo quieres importar las bebidas?" : {
      "comment" : "A message displayed when a user attempts to import a JSON file containing beverage data. The message offers options to merge, overwrite, or cancel the import.",
      "isCommentAutoGenerated" : true
    },
    "%@" : {
      "comment" : "A text view displaying the quantity of a specific item in a cart.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A label displaying the number of drinks consumed today. The argument is the count of drinks.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@%%" : {
      "comment" : "A label displaying the percentage of the budget that has been spent. The argument is a percentage value between 0.0 and 1.0.",
      "isCommentAutoGenerated" : true
    },
    "📝" : {
      "comment" : "An emoji that appears next to a consumicion note, indicating that there are notes associated with it.",
      "isCommentAutoGenerated" : true
    },
